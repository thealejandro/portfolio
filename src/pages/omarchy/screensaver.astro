---
import CopyCommand from '../../components/omarchy/CopyCommand.astro';
import OmarchyLayout from '../../components/omarchy/OmarchyLayout.astro';
import { SITE_TITLE } from '../../consts';

const REPO = 'https://github.com/thealejandro/omarchy-screensaver-fx';
const MEDIA = '/omarchy/screensaver';
const INSTALL = [
	`git clone ${REPO} ~/Work/omarchy-screensaver-fx`,
	'~/Work/omarchy-screensaver-fx/install.sh',
	'omarchy-launch-screensaver force',
].join('\n');

const title = `Screensaver FX para Omarchy · ${SITE_TITLE}`;
const description =
	'Seis animaciones nuevas para el salvapantallas de Omarchy, los efectos de siempre con los colores de tu tema y sin romperse con omarchy update.';

const animations = [
	{ id: 'neon', name: 'Neón', text: 'Los trazos se encienden con parpadeos, como tubos de neón, y luego respiran mientras un destello los cruza.' },
	{ id: 'starfield', name: 'Estrellas', text: 'Viajas entre estrellas mientras tu texto aparece poco a poco en el centro.' },
	{ id: 'terminal', name: 'Terminal', text: 'Una terminal escribe whoami y responde imprimiendo tu texto línea a línea.' },
	{ id: 'glitch', name: 'Glitch', text: 'Ráfagas de interferencia digital: desfase RGB, líneas desplazadas y ruido.' },
	{ id: 'plasma', name: 'Plasma', text: 'Un plasma con los colores de tu tema fluye dentro de las letras.' },
	{ id: 'clock', name: 'Reloj', text: 'Tu texto con un reloj grande y la fecha debajo, en el idioma de Omarchy.' },
];

const promises = [
	{ title: 'No toca Omarchy', text: 'Envuelve a ttfx y al script del salvapantallas sin copiar ni editar nada del paquete.' },
	{ title: 'Se revisa solo', text: 'Tras cada omarchy update, un hook comprueba que todo sigue igual y que cada animación arranca.' },
	{ title: 'Nunca se rompe', text: 'Si algo cambia, vuelve al salvapantallas original y te avisa con una notificación.' },
];
---

<OmarchyLayout title={title} description={description}>
	<section class="ss-stage" aria-labelledby="ss-title">
		<div class="om-wrap ss-hero">
			<p class="ss-kicker">Para Omarchy</p>
			<h1 id="ss-title">Screensaver FX</h1>
			<p class="ss-sub">Todos los efectos que ya te gustan. Y seis nuevos.</p>
			<div class="ss-actions">
				<a class="om-btn ss-btn" href="#instalar">Instalar</a>
				<a class="ss-link" href={REPO} target="_blank" rel="noopener noreferrer">Ver en GitHub <span aria-hidden="true">↗</span></a>
			</div>
		</div>
		<div class="om-wrap">
			<figure class="ss-video">
				<video
					controls
					muted
					playsinline
					preload="none"
					poster={`${MEDIA}/poster-es.webp`}
					width="1920"
					height="1080"
					aria-label="Presentación de Screensaver FX: las seis animaciones nuevas y los efectos con los colores del tema"
				>
					<source src={`${MEDIA}/demo-es.webm`} type="video/webm" />
					<source src={`${MEDIA}/demo-es.mp4`} type="video/mp4" />
				</video>
			</figure>
		</div>
	</section>

	<section class="om-section" aria-labelledby="anim-title">
		<div class="om-wrap">
			<div class="om-head">
				<p class="om-eyebrow">Seis animaciones propias</p>
				<h2 id="anim-title" class="om-h2">Tu texto, de seis formas nuevas</h2>
				<p class="om-lead">
					Dibujan el texto de tu salvapantallas (<code>screensaver.txt</code>), siempre centrado y con los colores
					del tema activo. Salen en un 35&nbsp;% de las vueltas; el resto, un efecto de <code>ttfx</code>, nunca el
					mismo dos veces seguidas.
				</p>
			</div>
			<ul class="ss-grid">
				{
					animations.map((a) => (
						<li class="ss-card">
							<img
								src={`${MEDIA}/shots/${a.id}.webp`}
								alt={`Animación ${a.name}`}
								width="750"
								height="450"
								loading="lazy"
								decoding="async"
							/>
							<div class="ss-card-text">
								<h3>
									{a.name} <code>{a.id}</code>
								</h3>
								<p>{a.text}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="om-section" aria-labelledby="tema-title">
		<div class="om-wrap ss-split">
			<div>
				<p class="om-eyebrow">Los colores de tu tema</p>
				<h2 id="tema-title" class="om-h2">Cambias de tema. Te sigue.</h2>
				<p class="om-lead">
					La mitad de las veces, los efectos de <code>ttfx</code> de Omarchy se pintan con los colores de acento de tu
					tema, aclarados lo justo para leerse sobre negro. Las animaciones propias los usan siempre.
				</p>
			</div>
			<img
				class="ss-themes"
				src={`${MEDIA}/themes.webp`}
				alt="El mismo efecto en tres temas: Tokyo Night, Rosé Pine y Everforest"
				width="1760"
				height="500"
				loading="lazy"
				decoding="async"
			/>
		</div>
	</section>

	<section class="om-section" aria-labelledby="upd-title">
		<div class="om-wrap">
			<div class="om-head">
				<p class="om-eyebrow">Sin sustos</p>
				<h2 id="upd-title" class="om-h2">Hecho para sobrevivir a las actualizaciones</h2>
			</div>
			<ol class="ss-promises">
				{
					promises.map((p) => (
						<li>
							<h3>{p.title}</h3>
							<p>{p.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section id="instalar" class="om-section" aria-labelledby="inst-title">
		<div class="om-wrap ss-install">
			<div class="om-head">
				<p class="om-eyebrow">Instalar</p>
				<h2 id="inst-title" class="om-h2">Tres líneas</h2>
				<p class="om-lead">
					El instalador enlaza los archivos del repo en su sitio, así que <code>git pull</code> lo actualiza todo.
					Para quitarlo, <code>./uninstall.sh</code>: vuelves al salvapantallas de Omarchy y tu texto no se toca.
				</p>
			</div>
			<CopyCommand command={INSTALL} label="Comandos de instalación de Screensaver FX" />
			<p class="ss-made">
				<a href="https://thealejandro.dev" aria-label="Hecho por thealejandro">
					<span>Hecho por</span>
					<img class="ss-logo-light" src={`${MEDIA}/logotipo-mono-oscuro.svg`} alt="thealejandro" width="153" height="16" />
					<img class="ss-logo-dark" src={`${MEDIA}/logotipo.svg`} alt="" width="153" height="16" />
				</a>
			</p>
		</div>
	</section>
</OmarchyLayout>

<style>
	.ss-stage {
		--ss-gray: #86868b;
		background: #000;
		color: #f5f5f7;
		padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2.5rem, 6vw, 5rem);
		text-align: center;
	}
	.ss-hero {
		display: grid;
		justify-items: center;
		gap: 0.75rem;
		margin-bottom: clamp(2rem, 5vw, 3.5rem);
	}
	.ss-kicker {
		margin: 0;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #8fa8ff;
	}
	.ss-stage h1 {
		margin: 0;
		font-size: clamp(2.6rem, 1.4rem + 6vw, 5.5rem);
		line-height: 1;
		letter-spacing: -0.035em;
		color: #f5f5f7;
	}
	.ss-sub {
		margin: 0.25rem 0 0;
		max-width: 32ch;
		font-size: clamp(1.15rem, 1rem + 0.9vw, 1.6rem);
		line-height: 1.3;
		color: var(--ss-gray);
	}
	.ss-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem 1.5rem;
		margin-top: 1rem;
	}
	.ss-btn {
		background: #f5f5f7;
		color: #000;
		border-radius: 999px;
	}
	.ss-btn:hover {
		background: #fff;
	}
	.ss-link {
		color: #8fa8ff;
		text-decoration: none;
		min-height: 44px;
		display: inline-flex;
		align-items: center;
	}
	.ss-link:hover {
		text-decoration: underline;
	}
	.ss-video {
		margin: 0;
		border-radius: clamp(12px, 2vw, 22px);
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: 0 30px 120px -30px rgba(122, 162, 247, 0.45);
		background: #000;
	}
	.ss-video video {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
	}
	.ss-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
		gap: 1.25rem;
	}
	.ss-card {
		border-radius: var(--om-radius);
		background: var(--om-surface);
		border: 1px solid var(--om-line);
		overflow: hidden;
	}
	.ss-card img {
		display: block;
		width: 100%;
		height: auto;
		background: #000;
	}
	.ss-card-text {
		padding: 1.1rem 1.25rem 1.3rem;
	}
	.ss-card h3 {
		margin: 0 0 0.35rem;
		font-size: 1.15rem;
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}
	.ss-card h3 code {
		font-size: 0.75rem;
		font-weight: 500;
	}
	.ss-card p {
		margin: 0;
		font-size: 0.95rem;
	}
	.ss-split {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
	}
	.ss-themes {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--om-radius);
		background: #000;
		box-shadow: var(--om-shadow-lg);
	}
	.ss-promises {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
		gap: 1.25rem;
		counter-reset: p;
	}
	.ss-promises li {
		counter-increment: p;
		padding: 1.4rem;
		border-radius: var(--om-radius);
		background: var(--om-soft);
		border: 1px solid var(--om-line);
	}
	.ss-promises li::before {
		content: counter(p);
		display: inline-grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		margin-bottom: 0.75rem;
		border-radius: 50%;
		background: var(--om-ink);
		color: #fff;
		font-weight: 700;
		font-size: 0.9rem;
	}
	.ss-promises h3 {
		margin: 0 0 0.35rem;
		font-size: 1.15rem;
	}
	.ss-promises p {
		margin: 0;
		font-size: 0.95rem;
	}
	.ss-install {
		max-width: 820px;
	}
	.ss-made {
		margin: 2.5rem 0 0;
		font-size: 0.9rem;
		color: var(--om-muted);
	}
	.ss-made a {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: inherit;
		text-decoration: none;
		min-height: 44px;
	}
	.ss-made img {
		height: 16px;
		width: auto;
	}
	/* Marca: la lente azul nunca sobre fondo claro. Con html[data-theme="dark"]
	   se usa el logotipo en color; en claro, el mono oscuro. */
	.ss-logo-dark {
		display: none;
	}
	:global(html[data-theme='dark']) .ss-logo-light {
		display: none;
	}
	:global(html[data-theme='dark']) .ss-logo-dark {
		display: block;
	}
</style>
