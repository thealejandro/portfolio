---
import { Image } from 'astro:assets';
import retrato from '../assets/marca/avatar-800.png';
import temasCaptura from '../assets/omarchy/aero/desktop.png';
import islaCaptura from '../assets/omarchy/omarchy-island.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icono from '../components/Icono.astro';
import { CREDITO_RETRATO, DIRECTO, LEMA, PERSONA, REDES, SITE_DESCRIPTION, SITE_TITLE, TEMAS_DIRECTO } from '../consts';

// Proyectos abiertos, enlazados a sus páginas del sitio.
const destacados = [
	{
		nombre: 'Temas para Omarchy',
		etiqueta: 'Open source · Linux',
		url: '/omarchy',
		desc: 'Once temas minimalistas inspirados en macOS y Windows, en claro y oscuro, con esquinas redondeadas y un prompt de fish a juego.',
		imagen: temasCaptura,
		alt: 'Escritorio de Omarchy con el tema Aero',
	},
	{
		nombre: 'omarchy-island',
		etiqueta: 'Open source · Quickshell',
		url: '/omarchy/island',
		desc: 'Isla dinámica para la barra: música con controles, calendario, temporizador de enfoque, clima y avisos de volumen, brillo y batería.',
		imagen: islaCaptura,
		alt: 'La isla dinámica desplegada con el reproductor de música',
	},
	{
		nombre: 'Salvapantallas FX',
		etiqueta: 'Open source · Terminal',
		url: '/omarchy/screensaver',
		desc: 'Seis animaciones nuevas para el salvapantallas de Omarchy, con los colores de tu tema y sin romperse con omarchy update.',
		imagen: null,
		alt: 'Fotograma del salvapantallas con el nombre en neón',
	},
];

// Trabajo con XACode: lista compacta, secundaria frente a lo abierto.
const xacode = [
	{ nombre: 'xaCare', etiqueta: 'SaaS · Salud', url: 'https://care.xacode.dev', desc: 'Gestión hospitalaria: pacientes, ingresos, quirófano, honorarios y cotizaciones. Multi-hospital.' },
	{ nombre: 'xaTiende', etiqueta: 'SaaS · Atención', url: 'https://xatiende.com', desc: 'Bandeja compartida de WhatsApp con bot de menús, asistente inteligente, catálogo y pedidos.' },
	{ nombre: 'xaSeguros', etiqueta: 'SaaS · Salud', url: 'https://seguros.xacode.dev', desc: 'Seguimiento tipo Kanban de reclamos a aseguradoras, facturas y consolidaciones FEL.' },
	{ nombre: 'xaPedidos', etiqueta: 'SaaS · Comercio', url: 'https://xacode.dev/es/#products', desc: 'Tienda móvil con marca propia: pedido confirmado por WhatsApp y panel de comandas.' },
	{ nombre: 'hospitalcoban.com', etiqueta: 'Web · Cliente', url: 'https://hospitalcoban.com', desc: 'Sitio bilingüe migrado de WordPress a Astro con CMS editable. Lighthouse móvil 37 → 99.' },
	{ nombre: 'Pharmasys', etiqueta: 'Rescate · Farmacia', url: 'https://pharmasys.xacode.dev', desc: 'Farmacia y punto de venta rescatado de Heroku en 48 horas, con facturación FEL integrada.' },
];

const stack = ['PHP', 'Laravel', 'Livewire', 'Astro', 'Tailwind CSS', 'Vue 3', 'PostgreSQL', 'MySQL', 'Cloudflare', 'Linux', 'Docker', 'QML'];
const anios = new Date().getFullYear() - 2018;
const externo = { target: '_blank', rel: 'noopener noreferrer' };
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${SITE_TITLE} — ${LEMA}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="wrap pb-8">
			<!-- Hero -->
			<section
				class="grid items-center gap-x-12 gap-y-8 pt-[clamp(2rem,6vw,4.5rem)] md:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]"
				aria-labelledby="hola"
			>
				<div class="grid content-start gap-5">
					<p class="etiqueta m-0" data-enter style="--i:0">{PERSONA.rol} · {PERSONA.ciudad}, {PERSONA.pais}</p>
					<h1 id="hola" class="display m-0 text-ink" data-enter style="--i:1">
						{LEMA}<span class="text-accent">.</span>
					</h1>
					<p class="m-0 max-w-[58ch] text-lead text-body" data-enter style="--i:2">
						Soy Alejandro, <span class="whitespace-nowrap">{PERSONA.alias}</span>. Hago software para hospitales y negocios con{' '}
						<a href={PERSONA.empresa.url} class="font-semibold text-ink underline underline-offset-3 hover:text-accent">{PERSONA.empresa.nombre}</a>,
						publico herramientas para el escritorio Linux y lo cuento en directo.
					</p>
					<ul class="m-0 flex list-none flex-wrap gap-2 p-0" role="list" aria-label="De qué va el directo" data-enter style="--i:3">
						{TEMAS_DIRECTO.map((t) => <li class="chip">{t}</li>)}
					</ul>
					<div class="flex flex-wrap gap-2.5" data-enter style="--i:4">
						<a href="#directo" class="btn btn-primary">
							<Icono nombre="directo" class="size-5" />Ver los directos
						</a>
						<a href="#proyectos" class="btn btn-ghost">Proyectos</a>
					</div>
				</div>
				<figure class="m-0 grid w-[min(100%,22rem)] gap-2 justify-self-center md:justify-self-end" data-enter style="--i:1">
					<Image
						src={retrato}
						alt={`Retrato ilustrado de ${PERSONA.nombre}`}
						widths={[320, 480, 704]}
						sizes="(max-width: 767px) min(100vw - 32px, 352px), 352px"
						loading="eager"
						fetchpriority="high"
						class="aspect-square h-auto w-full rounded-ventana bg-esmalte-2 object-cover shadow-imagen"
					/>
					<figcaption class="etiqueta text-right">{CREDITO_RETRATO}</figcaption>
				</figure>
			</section>

			<!-- En directo -->
			<section id="directo" class="section" aria-labelledby="directo-t">
				<div class="grid gap-6 rounded-ventana border border-line bg-esmalte-2 p-[clamp(1.5rem,4vw,2.5rem)] text-loza md:grid-cols-[minmax(0,1fr)_auto] md:items-end" data-reveal>
					<div class="grid gap-3">
						<p class="etiqueta m-0 flex items-center gap-2 !text-loza/80">
							<span class="size-2 rounded-full bg-ocre" aria-hidden="true"></span>En directo
						</p>
						<h2 id="directo-t" class="titulo m-0 text-title text-loza">Directos tres noches por semana</h2>
						<p class="dato m-0 text-[clamp(1rem,2.6vw,1.25rem)] text-loza">
							<span class="sr-only">Horario: </span>{DIRECTO.horario}
						</p>
						<p class="m-0 max-w-[56ch] text-loza/80">
							Programo proyectos reales, configuro Linux y macOS, monto redes en el taller y comentamos lo que pasa en tech. De vez en cuando, juegos.
						</p>
					</div>
					<ul class="m-0 flex list-none flex-wrap gap-2.5 p-0" role="list">
						{
							DIRECTO.plataformas.map((r) => (
								<li>
									<a href={r.url} {...externo} class="btn bg-loza text-esmalte hover:bg-white hover:text-esmalte">
										<Icono nombre={r.id} class="size-5" />
										{r.nombre}
										<span class="sr-only"> ({r.usuario}, se abre en otra pestaña)</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<!-- Proyectos abiertos -->
			<section id="proyectos" class="section" aria-labelledby="proyectos-t">
				<p class="etiqueta m-0 mb-2" data-reveal>Proyectos</p>
				<h2 id="proyectos-t" class="titulo m-0 mb-6 text-title text-ink" data-reveal>Para el escritorio Linux</h2>
				<ul class="m-0 grid list-none gap-5 p-0 md:grid-cols-3" role="list">
					{
						destacados.map((p, i) => (
							<li class="flex" data-reveal style={`--i:${i}`}>
								<a
									href={p.url}
									class="group grid w-full content-start gap-3 rounded-azulejo border border-line bg-surface p-3 pb-5 text-inherit no-underline transition-colors hover:border-line-strong hover:text-inherit"
								>
									{p.imagen ? (
										<Image
											src={p.imagen}
											alt={p.alt}
											widths={[400, 640, 800]}
											sizes="(max-width: 767px) calc(100vw - 32px), 380px"
											class="aspect-video h-auto w-full rounded-pieza bg-esmalte-2 object-cover"
										/>
									) : (
										<img
											src="/omarchy/screensaver/poster-es.webp"
											alt={p.alt}
											width="1920"
											height="1080"
											loading="lazy"
											decoding="async"
											class="aspect-video h-auto w-full rounded-pieza bg-esmalte-2 object-cover"
										/>
									)}
									<div class="grid gap-1.5 px-2">
										<span class="etiqueta">{p.etiqueta}</span>
										<h3 class="titulo m-0 flex items-center gap-2 text-[1.2rem] text-ink">
											{p.nombre}
											<Icono nombre="flecha" class="size-4.5 text-accent transition-transform duration-300 ease-rodillo group-hover:translate-x-1" />
										</h3>
										<p class="m-0 text-[0.95rem] leading-normal text-body">{p.desc}</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<!-- XACode -->
			<section id="xacode" class="section" aria-labelledby="xacode-t">
				<p class="etiqueta m-0 mb-2" data-reveal>Trabajo</p>
				<h2 id="xacode-t" class="titulo m-0 mb-3 text-title text-ink" data-reveal>Con XACode</h2>
				<p class="m-0 mb-6 max-w-[62ch] text-body" data-reveal>
					Desde 2018 hago sistemas a medida y productos SaaS para hospitales, farmacias y negocios de Guatemala.
				</p>
				<dl class="m-0 mb-7 flex flex-wrap gap-x-10 gap-y-4" data-reveal>
					<div class="flex flex-col-reverse"><dt class="text-sm text-muted">años desarrollando</dt><dd class="cifra m-0 text-2xl text-ink">+{anios}</dd></div>
					<div class="flex flex-col-reverse"><dt class="text-sm text-muted">productos SaaS propios</dt><dd class="cifra m-0 text-2xl text-ink">5</dd></div>
					<div class="flex flex-col-reverse"><dt class="text-sm text-muted">{PERSONA.region}</dt><dd class="cifra m-0 text-2xl text-ink">{PERSONA.ciudad}</dd></div>
				</dl>
				<ul class="m-0 grid list-none gap-x-8 p-0 md:grid-cols-2" role="list">
					{
						xacode.map((p) => (
							<li class="border-t border-line" data-reveal="fade">
								<a href={p.url} {...externo} class="group grid gap-1 py-4 text-inherit no-underline hover:text-inherit">
									<span class="flex flex-wrap items-baseline justify-between gap-x-3">
										<span class="titulo text-[1.05rem] text-ink group-hover:text-accent">
											{p.nombre}
											<span class="sr-only"> (se abre en otra pestaña)</span>
										</span>
										<span class="etiqueta">{p.etiqueta}</span>
									</span>
									<span class="text-[0.93rem] leading-normal text-body">{p.desc}</span>
								</a>
							</li>
						))
					}
				</ul>
				<h3 class="etiqueta mt-8 mb-3">Herramientas</h3>
				<ul class="m-0 flex list-none flex-wrap gap-2 p-0" role="list">
					{stack.map((s) => <li class="chip dato text-[0.8rem]">{s}</li>)}
				</ul>
			</section>

			<!-- Contacto y redes -->
			<section id="contacto" class="section" aria-labelledby="contacto-t">
				<div class="grid gap-6 rounded-ventana border border-line bg-surface p-[clamp(1.5rem,4vw,2.5rem)] md:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]" data-reveal>
					<div class="grid content-start gap-3">
						<h2 id="contacto-t" class="titulo m-0 text-title text-ink">Hablemos</h2>
						<p class="m-0 text-body">¿Un proyecto, una charla o una idea para el directo? Escríbeme.</p>
						<a href={`mailto:${PERSONA.email}`} class="btn btn-primary w-fit [overflow-wrap:anywhere]">
							<Icono nombre="correo" class="size-5" />{PERSONA.email}
						</a>
					</div>
					<ul class="m-0 grid list-none gap-2 p-0 sm:grid-cols-2" role="list" aria-label="Redes">
						{
							REDES.map((r) => (
								<li>
									<a
										href={r.url}
										{...externo}
										class="flex min-h-12 items-center gap-3 rounded-azulejo border border-line px-3.5 text-body no-underline transition-colors hover:border-accent hover:text-ink"
									>
										<Icono nombre={r.id} class="size-5 shrink-0 text-ink" />
										<span class="grid leading-tight">
											<span class="font-semibold text-ink">{r.nombre}</span>
											<span class="dato text-[0.8rem] text-muted">{r.id === 'linkedin' || r.id === 'kick' ? r.usuario : `@${r.usuario}`}</span>
										</span>
										<span class="sr-only"> (se abre en otra pestaña)</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
