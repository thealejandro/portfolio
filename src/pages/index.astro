---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import cv from '../data/cv.json';

const projects = [
	{
		name: 'xaCare',
		tag: 'SaaS · Salud',
		url: 'https://care.xacode.dev',
		desc: 'Plataforma de gestión hospitalaria: pacientes, ingresos, quirófano (QxLog), honorarios y cotizaciones de cirugía. Multi-hospital, con roles por institución.',
		stack: ['Laravel 12', 'Livewire', 'Flux UI', 'Tailwind'],
	},
	{
		name: 'xaTiende',
		tag: 'SaaS · Atención al cliente',
		url: 'https://xatiende.com',
		desc: 'Bandeja compartida de WhatsApp para equipos, con bot de menús y flujos, asistente inteligente (Olmar), catálogo y pedidos. En beta con pilotos.',
		stack: ['Laravel 13', 'Vue 3', 'PostgreSQL', 'Reverb'],
	},
	{
		name: 'xaSeguros',
		tag: 'SaaS · Salud',
		url: 'https://seguros.xacode.dev',
		desc: 'Tablero tipo Kanban para dar seguimiento a reclamos de aseguradoras: etapas, facturas, regla del 25, calculadora de participaciones y consolidaciones FEL.',
		stack: ['Laravel 13', 'Livewire 4', 'Flux UI', 'Laravel Cloud'],
	},
	{
		name: 'xaPedidos',
		tag: 'SaaS · Comercio',
		url: 'https://xacode.dev/es/#products',
		desc: 'Tienda móvil con marca propia para cada negocio: el cliente arma su pedido, confirma por WhatsApp y le da seguimiento. Panel de comandas para cocina.',
		stack: ['Laravel 13', 'Livewire 4', 'Tailwind 4'],
	},
	{
		name: 'hospitalcoban.com',
		tag: 'Web · Cliente',
		url: 'https://hospitalcoban.com',
		desc: 'Sitio institucional bilingüe del Hospital Nuestra Señora del Carmen. Migración de WordPress a Astro con CMS editable por el hospital. Lighthouse móvil 37 → 99.',
		stack: ['Astro', 'Keystatic', 'Tailwind 4', 'Cloudflare'],
	},
	{
		name: 'Pharmasys',
		tag: 'Rescate · Farmacia',
		url: 'https://pharmasys.xacode.dev',
		desc: 'Sistema de farmacia y punto de venta rescatado de Heroku en 48 horas, con más de 270 mil ventas recuperadas y facturación electrónica FEL (SAT) integrada.',
		stack: ['Laravel 6', 'MariaDB', 'HestiaCP', 'FEL'],
	},
	{
		name: 'Temas para Omarchy',
		tag: 'Open source · Linux',
		url: '/omarchy',
		desc: 'Once temas minimalistas para Omarchy inspirados en macOS y Windows, en claro y oscuro, con hooks que añaden esquinas redondeadas y un prompt de fish a juego.',
		stack: ['Hyprland', 'Bash', 'Python', 'fish'],
	},
	{
		name: 'omarchy-island',
		tag: 'Open source · Linux',
		url: '/omarchy/island',
		desc: 'Isla dinámica para la barra de Omarchy: música con controles, calendario, temporizador de enfoque, clima, accesos rápidos y avisos de volumen, brillo y batería.',
		stack: ['QML', 'Quickshell', 'JavaScript'],
	},
];

const stack = [
	'PHP', 'Laravel', 'Livewire', 'Flux UI', 'Blade', 'Tailwind CSS', 'Astro',
	'Vue 3', 'JavaScript', 'MySQL', 'PostgreSQL', 'Cloudflare', 'Linux', 'Docker',
];

const yearsExp = new Date().getFullYear() - 2018;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${SITE_TITLE} — Desarrollador full stack · XACode`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="mx-auto w-[min(960px,100%-32px)] pt-[clamp(1.5rem,5vw,3rem)] pb-16">
			<section
				class="grid items-start gap-x-10 gap-y-5 border-b border-line pt-6 pb-12 [grid-template-areas:'photo''badge''title''lead''actions''facts'] md:grid-cols-[minmax(0,1fr)_auto] md:[grid-template-areas:'badge_photo''title_photo''lead_photo''actions_photo''facts_facts']"
				aria-labelledby="hola"
			>
				<Image
					src={avatar}
					alt="Foto de José Alejandro Caal Choc"
					widths={[120, 240, 336]}
					sizes="(max-width: 767px) 120px, 168px"
					loading="eager"
					fetchpriority="high"
					class="size-30 self-center rounded-full border-4 border-white object-cover shadow-card [grid-area:photo] md:size-42"
					data-enter
					style="--i:0"
				/>
				<span
					class="inline-flex w-fit items-center gap-2 rounded-full border border-[#c9dcc5] bg-[#f0f5ee] px-3.5 py-1 text-[0.72rem] font-bold tracking-widest text-[#3d5c38] uppercase [grid-area:badge]"
					data-enter
					style="--i:1"
				>
					<span class="size-1.75 rounded-full bg-[#3d9a4f] shadow-[0_0_0_3px_rgb(61_154_79/0.2)] motion-safe:animate-pulse" aria-hidden="true"></span>
					Disponible para proyectos
				</span>
				<h1 id="hola" class="m-0 text-[clamp(2.1rem,5vw,3.4rem)] leading-[1.08] tracking-[-0.02em] [grid-area:title]" data-enter style="--i:2">
					Hola, soy <span class="text-accent">Alejandro</span>.<br />Construyo software que la gente usa todos los días.
				</h1>
				<p class="m-0 max-w-160 text-[1.15rem] leading-relaxed text-body [grid-area:lead]" data-enter style="--i:3">
					Desarrollador full stack con Laravel, Livewire y Astro. Fundador de <a class="font-bold no-underline hover:underline" href="https://xacode.dev">XACode</a>,
					donde hacemos sistemas a medida y productos SaaS para hospitales, farmacias y negocios en Guatemala.
				</p>
				<div class="mt-2 flex flex-wrap gap-2.5 [grid-area:actions]" data-enter style="--i:4">
					<a href="#proyectos" class="btn btn-primary">Ver proyectos <span aria-hidden="true">→</span></a>
					<a href="/cv" class="btn btn-ghost">Ver mi CV</a>
				</div>
				<dl class="mt-2 flex flex-wrap gap-x-10 gap-y-6 text-[0.9rem] text-muted [grid-area:facts]" data-enter style="--i:5">
					<div class="flex flex-col-reverse"><dt>años desarrollando</dt><dd class="m-0 text-2xl leading-tight font-bold text-ink">+{yearsExp}</dd></div>
					<div class="flex flex-col-reverse"><dt>productos SaaS propios</dt><dd class="m-0 text-2xl leading-tight font-bold text-ink">5</dd></div>
					<div class="flex flex-col-reverse"><dt>Alta Verapaz, Guatemala</dt><dd class="m-0 text-2xl leading-tight font-bold text-ink">Cobán</dd></div>
				</dl>
			</section>

			<section id="que-hago" class="scroll-mt-20 pt-12" aria-labelledby="que-hago-t">
				<h2 id="que-hago-t" class="label" data-reveal>Qué hago</h2>
				<div class="grid gap-4 md:grid-cols-3">
					{
						[
							['Sistemas a medida', 'Aplicaciones web con Laravel y Livewire: desde el modelo de datos hasta el despliegue, con pruebas automatizadas y documentación para quien siga.'],
							['Sitios web rápidos', 'Sitios con Astro y Tailwind que cargan en segundos y que el cliente edita solo. Migraciones desde WordPress sin perder tráfico.'],
							['Infraestructura y rescates', 'Hosting administrado, Cloudflare, respaldos, correo corporativo y recuperación de sistemas que se quedaron sin servidor.'],
						].map(([h, p], i) => (
							<article class="rounded-xl border border-line bg-white p-5" data-reveal style={`--i:${i}`}>
								<h3 class="mb-1.5 text-[1.05rem]">{h}</h3>
								<p class="m-0 text-[0.92rem] leading-normal text-body">{p}</p>
							</article>
						))
					}
				</div>
			</section>

			<section id="proyectos" class="scroll-mt-20 pt-12" aria-labelledby="proyectos-t">
				<p class="label" data-reveal>Proyectos</p>
				<h2 id="proyectos-t" class="mb-5 text-[1.8rem]" data-reveal>Lo que he construido últimamente</h2>
				<ul class="grid gap-4 md:grid-cols-2" role="list">
					{
						projects.map((p, i) => {
							const local = p.url.startsWith('/');
							return (
								<li class="flex" data-reveal style={`--i:${i % 2}`}>
									<a
										class="group flex w-full flex-col gap-2.5 rounded-xl border border-line bg-white p-5 text-inherit no-underline transition-[box-shadow,transform] duration-500 ease-apple hover:-translate-y-1 hover:text-inherit hover:shadow-lift active:scale-[0.99]"
										href={p.url}
										target={local ? undefined : '_blank'}
										rel={local ? undefined : 'noopener noreferrer'}
									>
										<div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-1">
											<h3 class="m-0 text-[1.15rem]">
												{p.name}
												{!local && <span class="sr-only"> (se abre en otra pestaña)</span>}
											</h3>
											<span class="text-[0.7rem] font-bold tracking-[0.06em] text-muted uppercase">{p.tag}</span>
										</div>
										<p class="m-0 text-[0.92rem] leading-normal text-body">{p.desc}</p>
										<div class="mt-auto flex flex-wrap gap-1.5 pt-1.5">
											{p.stack.map((s) => (
												<span class="rounded-full border border-[#d9d0ee] bg-[#ede9f6] px-2.5 py-0.5 text-[0.72rem] text-[#4a3870]">{s}</span>
											))}
										</div>
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>

			<section id="stack" class="scroll-mt-20 pt-12" aria-labelledby="stack-t">
				<h2 id="stack-t" class="label" data-reveal>Herramientas</h2>
				<ul class="flex flex-wrap gap-1.5" role="list" data-reveal>
					{stack.map((s) => <li class="rounded-full bg-line px-2.5 py-0.5 text-[0.78rem] text-body">{s}</li>)}
				</ul>
			</section>

			<section id="contacto" class="scroll-mt-20 pt-12" aria-labelledby="contacto-t">
				<div class="grid gap-3 rounded-2xl bg-[#1a1a1a] p-[clamp(1.5rem,4vw,2rem)] text-white" data-reveal="zoom">
					<h2 id="contacto-t" class="m-0 text-[1.6rem] text-white">¿Tienes un proyecto?</h2>
					<p class="m-0 text-[0.98rem] text-[#cfcfcf]">
						Escríbeme y platicamos. Respondo en menos de 24 horas hábiles. Para trabajo con
						empresa, ve a XACode.
					</p>
					<div class="mt-2 flex flex-wrap gap-2.5">
						{
							[
								[`mailto:${cv.basics.email}`, cv.basics.email],
								['https://xacode.dev', 'xacode.dev'],
								['https://github.com/thealejandro', 'GitHub'],
								['https://linkedin.com/in/thealejandro', 'LinkedIn'],
							].map(([href, label]) => (
								<a
									class="inline-flex min-h-11 items-center rounded-lg border border-[#444] px-3.5 text-[0.9rem] text-white no-underline transition-colors hover:border-white hover:text-white [overflow-wrap:anywhere]"
									href={href}
									target={href.startsWith('http') ? '_blank' : undefined}
									rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
								>
									{label}
								</a>
							))
						}
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	@reference '../styles/global.css';
	.label {
		@apply mb-5 text-[0.78rem] font-bold tracking-[0.12em] text-muted uppercase;
	}
</style>
