---
// Importa global.css (Tailwind) para que todas las páginas lo incluyan vía <BaseHead />.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import retrato from '../assets/marca/avatar-800.png';
import { PERSONA, REDES, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** Precargar la fuente del sitio (Bricolage, latín). El CV usa otras. */
	preloadFonts?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, preloadFonts = true } = Astro.props;
const ogImage = new URL(image ? image.src : '/og-default.png', Astro.site);

// Datos estructurados de la persona y del sitio, solo en la portada.
const portada = Astro.url.pathname === '/';
let jsonLd: string | undefined;
if (portada) {
	const foto = await getImage({ src: retrato, width: 800, format: 'webp' });
	jsonLd = JSON.stringify([
		{
			'@context': 'https://schema.org',
			'@type': 'Person',
			'@id': `${SITE_URL}/#persona`,
			name: PERSONA.nombre,
			alternateName: PERSONA.alias,
			url: SITE_URL,
			image: new URL(foto.src, Astro.site).href,
			jobTitle: PERSONA.rol,
			email: `mailto:${PERSONA.email}`,
			worksFor: { '@type': 'Organization', name: PERSONA.empresa.nombre, url: PERSONA.empresa.url },
			address: {
				'@type': 'PostalAddress',
				addressLocality: PERSONA.ciudad,
				addressRegion: PERSONA.region,
				addressCountry: 'GT',
			},
			sameAs: REDES.map((r) => r.url),
		},
		{
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: SITE_TITLE,
			url: SITE_URL,
			inLanguage: 'es',
			description: SITE_DESCRIPTION,
			author: { '@id': `${SITE_URL}/#persona` },
		},
	]);
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0e0c0b" />
<!-- Tema sin parpadeo: elección guardada o, si no hay, la del sistema. -->
<script is:inline>
	(function () {
		var d = document.documentElement, t;
		d.classList.add('js');
		try { t = localStorage.getItem('tema'); } catch (e) {}
		if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
		d.setAttribute('data-theme', t);
		if (t === 'light') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#f4ecdc');
	})();
</script>
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

{preloadFonts && <link rel="preload" href="/fonts/bricolage-grotesque-var.woff2" as="font" type="font/woff2" crossorigin />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_GT" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{!image && <meta property="og:image:width" content="1200" />}
{!image && <meta property="og:image:height" content="630" />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@thealejandro__" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
