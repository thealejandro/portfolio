---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialIcons from './SocialIcons.astro';
---

<header class="relative z-30 bg-white shadow-[0_2px_8px_rgb(15_18_25/0.05)]">
	<nav class="wrap flex min-h-14 items-center justify-between gap-2" aria-label="Principal">
		<a href="/" class="py-3 text-base font-bold text-ink no-underline">{SITE_TITLE}</a>
		<div class="-mr-2 flex items-center sm:mr-0">
			<HeaderLink href="/" class="max-[379px]:hidden">Inicio</HeaderLink>
			<HeaderLink href="/omarchy">Omarchy</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/cv">CV</HeaderLink>
		</div>
		<SocialIcons class="hidden text-ink md:flex" />
	</nav>
</header>
