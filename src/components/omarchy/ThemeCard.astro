---
import { Image } from 'astro:assets';
import ModeBadge from './ModeBadge.astro';
import { vtName, type Theme } from './themes';

interface Props {
	theme: Theme;
	eager?: boolean;
}
const { theme: t, eager = false } = Astro.props;
const strip = ['background', 'foreground', 'accent', 'red', 'yellow', 'green', 'cyan', 'blue', 'magenta'];
---

<a
	class="group flex h-full flex-col overflow-hidden rounded-card border border-line bg-surface text-inherit no-underline transition-[box-shadow,transform,border-color] duration-500 ease-apple hover:-translate-y-1 hover:border-[#d5dbe6] hover:text-inherit hover:shadow-lift focus-visible:outline-offset-4 active:scale-[0.985] active:duration-150"
	href={`/omarchy/${t.slug}`}
>
	<div class="relative aspect-video overflow-hidden border-b border-line" style={`background:${t.palette.background}`}>
		{
			t.cover && (
				<Image
					src={t.cover.img}
					alt=""
					widths={[480, 800]}
					sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 1000px) calc(50vw - 28px), 380px"
					loading={eager ? 'eager' : 'lazy'}
					class="block size-full object-cover transition-transform duration-700 ease-apple group-hover:scale-[1.04]"
					style={`view-transition-name:${vtName(t.slug)}`}
				/>
			)
		}
		{
			t.shots.length > 1 && (
				<span class="absolute bottom-2.5 left-2.5 rounded-full bg-esmalte/85 px-2 py-0.5 text-[0.72rem] font-bold text-loza">
					{t.shots.length} capturas
				</span>
			)
		}
	</div>
	<div class="grid gap-1.5 px-[1.15rem] pt-4 pb-[1.15rem]">
		<div class="flex items-center justify-between gap-3">
			<h3 class="m-0 text-[1.2rem] tracking-[-0.01em]">{t.name}</h3>
			<ModeBadge mode={t.mode} />
		</div>
		<p class="m-0 text-[0.9rem] text-muted">{t.tag}</p>
		<div class="mt-2 flex h-2.5 overflow-hidden rounded-full border border-ink/10" aria-hidden="true">
			{strip.map((k, i) => <span class:list={[i === 0 ? 'flex-2' : 'flex-1']} style={`background:${t.palette[k]}`} />)}
		</div>
	</div>
</a>
