---
import CopyCommand from './CopyCommand.astro';
import { buildCommands, HOOKS } from './commands';
import type { Theme } from './themes';

interface Props {
	themes: Theme[];
}
const { themes } = Astro.props;
const allThemes = themes.map((t) => t.slug);
const initial = buildCommands({ themes: allThemes, allThemes, hooks: [...HOOKS], island: false });

const hookInfo: Record<string, { name: string; desc: string }> = {
	'40-theme-shape': { name: 'Esquinas redondeadas', desc: 'Aplica el radio de cada tema a las ventanas.' },
	'30-tide-colors': { name: 'Colores del prompt', desc: 'Tiñe el prompt Tide de fish con la paleta.' },
};
---

<section id="instalar" class="section" aria-labelledby="instalar-title">
	<div class="wrap">
		<div class="mb-8" data-reveal>
			<p class="eyebrow">Instalación</p>
			<h2 id="instalar-title" class="title">Arma tu instalación</h2>
			<p class="lead">
				Marca lo que quieres y copia los comandos. Los temas se actualizan con
				<code class="inline-code">omarchy theme update</code> y se quitan con <code class="inline-code">omarchy theme remove</code>.
			</p>
		</div>

		<div
			class="grid grid-cols-1 items-start gap-6 [html:not(.js)_&]:max-w-180 md:[html.js_&]:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)]"
			data-builder
			data-all={allThemes.join(' ')}
			data-reveal
			style="--i:1"
		>
			<form class="card grid gap-5 p-[clamp(1rem,2.5vw,1.5rem)]" data-js-only aria-label="Qué instalar">
				<fieldset class="m-0 min-w-0 border-0 p-0">
					<div class="flex items-center justify-between gap-4">
						<legend class="float-left mb-2.5 p-0 font-bold text-ink">Temas</legend>
						<div class="flex gap-1.5">
							<button type="button" class="pill min-h-9 px-3 text-[0.8rem]" data-select="all">Todos</button>
							<button type="button" class="pill min-h-9 px-3 text-[0.8rem]" data-select="none">Ninguno</button>
						</div>
					</div>
					<div class="clear-both grid grid-cols-[repeat(auto-fill,minmax(min(100%,150px),1fr))] gap-2">
						{
							themes.map((t) => (
								<label class="opt">
									<input type="checkbox" name="theme" value={t.slug} checked />
									<span
										class="size-[18px] flex-none rounded-full"
										style={`background:${t.palette.background};box-shadow:inset 0 0 0 4px ${t.palette.accent},0 0 0 1px rgb(15 18 25/0.12)`}
										aria-hidden="true"
									/>
									<span class="grid min-w-0 leading-tight">
										<span class="text-[0.92rem] font-bold text-ink">{t.name}</span>
										<span class="text-[0.78rem] text-muted">{t.modeLabel}</span>
									</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<fieldset class="m-0 min-w-0 border-0 p-0">
					<legend class="mb-2.5 p-0 font-bold text-ink">Hooks</legend>
					<div class="grid gap-2">
						{
							HOOKS.map((h) => (
								<label class="opt">
									<input type="checkbox" name="hook" value={h} checked />
									<span class="grid min-w-0 leading-tight">
										<span class="text-[0.92rem] font-bold text-ink">{hookInfo[h].name}</span>
										<span class="text-[0.78rem] text-muted">
											<code class="inline-code text-[0.95em]">{h}</code> · {hookInfo[h].desc}
										</span>
									</span>
								</label>
							))
						}
					</div>
				</fieldset>

				<fieldset class="m-0 min-w-0 border-0 p-0">
					<legend class="mb-2.5 p-0 font-bold text-ink">Plugin</legend>
					<div class="grid gap-2">
						<label class="opt">
							<input type="checkbox" name="island" value="island" />
							<span class="grid min-w-0 leading-tight">
								<span class="text-[0.92rem] font-bold text-ink">omarchy-island</span>
								<span class="text-[0.78rem] text-muted">Isla dinámica junto al reloj de la barra. <a href="/omarchy/island" class="relative z-10 underline decoration-accent/35 underline-offset-[3px] hover:decoration-accent">Qué hace</a></span>
							</span>
						</label>
					</div>
				</fieldset>
			</form>

			<div class="md:sticky md:top-16">
				<div class="grid grid-cols-1 gap-3 rounded-card border border-line bg-soft p-[clamp(1rem,2.5vw,1.5rem)]">
					<p class="m-0 font-bold text-ink" data-summary aria-live="polite">
						{themes.length} temas y los dos hooks.
					</p>
					<CopyCommand command={initial} label="Comandos de instalación" class="out-cmd [&_pre]:min-h-22" />
					<p class="m-0 text-[0.85rem] text-muted" data-no-js>
						Este comando instala los hooks y todos los temas. Para uno solo, usa el comando de su página.
					</p>
					<p class="m-0 text-[0.85rem] text-muted" data-js-only>
						Pégalo en una terminal de Omarchy. Si ya clonaste <code class="inline-code">omarchy-themes</code>, omite la línea
						<code class="inline-code">git clone</code>.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	@reference '../../styles/global.css';
	.opt {
		@apply flex min-h-12 cursor-pointer items-center gap-2.5 rounded-xl border border-line bg-surface px-3 py-2;
		transition:
			border-color 0.15s,
			background-color 0.15s,
			transform 0.35s var(--ease-spring);
	}
	.opt:hover {
		@apply border-line-strong;
	}
	.opt:active {
		transform: scale(0.98);
	}
	.opt:has(input:checked) {
		@apply border-line-strong bg-soft;
	}
	.opt:has(input:focus-visible) {
		@apply outline-2 outline-offset-2 outline-accent;
	}
	.opt input {
		@apply m-0 size-[18px] flex-none accent-ink;
	}
	.opt input:focus-visible {
		outline: none;
	}
</style>

<script>
	import { buildCommands } from './commands';

	const root = document.querySelector<HTMLElement>('[data-builder]');
	const form = root?.querySelector<HTMLFormElement>('form');
	if (root && form) {
		const allThemes = (root.dataset.all ?? '').split(' ');
		const code = root.querySelector<HTMLElement>('.out-cmd code')!;
		const summary = root.querySelector<HTMLElement>('[data-summary]')!;
		const values = (name: string) =>
			[...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value);

		const update = () => {
			const themes = values('theme');
			const hooks = values('hook');
			const island = values('island').length > 0;
			const cmd = buildCommands({ themes, allThemes, hooks, island });
			code.textContent = cmd || '# Marca al menos un tema, un hook o el plugin.';

			const parts: string[] = [];
			if (themes.length) parts.push(themes.length === 1 ? '1 tema' : `${themes.length} temas`);
			if (hooks.length === 2) parts.push('los dos hooks');
			else if (hooks.length === 1) parts.push('1 hook');
			if (island) parts.push('omarchy-island');
			summary.textContent = parts.length
				? `${parts.length > 1 ? `${parts.slice(0, -1).join(', ')} y ${parts.at(-1)}` : parts[0]}.`
				: 'Nada seleccionado.';
		};

		form.addEventListener('change', update);
		root.querySelectorAll<HTMLButtonElement>('[data-select]').forEach((b) =>
			b.addEventListener('click', () => {
				const on = b.dataset.select === 'all';
				form.querySelectorAll<HTMLInputElement>('input[name="theme"]').forEach((i) => (i.checked = on));
				update();
			}),
		);
		update();
	}
</script>
