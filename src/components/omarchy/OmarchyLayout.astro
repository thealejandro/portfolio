---
import type { ImageMetadata } from 'astro';
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import Lightbox from './Lightbox.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** Enlace activo de la navegación de la sección. */
	current?: 'temas' | 'galeria' | 'isla' | 'tema';
}

const { title, description, image, current } = Astro.props;

const nav = [
	{ id: 'temas', href: '/omarchy', label: 'Temas' },
	{ id: 'isla', href: '/omarchy/island', label: 'Isla' },
	{ id: 'galeria', href: '/omarchy/galeria', label: 'Galería' },
	{ id: 'instalar', href: '/omarchy#instalar', label: 'Instalar' },
];
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<Header />
		<nav
			class="sticky top-0 z-20 border-b border-line/80 bg-white/80 backdrop-blur-xl backdrop-saturate-150"
			aria-label="Sección Omarchy"
		>
			<div class="wrap flex min-h-12 items-center justify-between gap-3">
				<a href="/omarchy" class="shrink-0 py-2 font-bold tracking-tight text-ink no-underline">Omarchy</a>
				<ul class="-mr-2 flex items-center gap-0.5 overflow-x-auto sm:gap-1" role="list">
					{
						nav.map((n) => (
							<li>
								<a
									href={n.href}
									aria-current={n.id === current ? 'page' : undefined}
									class:list={[
										'inline-flex min-h-11 items-center rounded-full px-2.5 text-[0.88rem] whitespace-nowrap no-underline transition-colors duration-200 sm:px-3.5',
										n.id === current ? 'font-bold text-ink' : 'text-muted hover:text-ink',
										n.id === 'instalar' && 'max-[359px]:hidden',
									]}
								>
									{n.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</nav>
		<main class="overflow-x-clip pb-12">
			<slot />
			<p class="wrap mt-16 border-t border-line pt-5 text-[0.85rem] text-muted">
				Sin relación con Apple ni Microsoft. Temas, hooks y plugin con licencia MIT.
			</p>
		</main>
		<Footer />
		<Lightbox />
		<p id="om-live" class="sr-only" aria-live="polite"></p>
		<script>
			const live = document.getElementById('om-live');
			const announce = (msg: string) => {
				if (!live) return;
				live.textContent = '';
				requestAnimationFrame(() => (live.textContent = msg));
			};

			async function copy(text: string) {
				try {
					await navigator.clipboard.writeText(text);
					return true;
				} catch {
					const ta = document.createElement('textarea');
					ta.value = text;
					ta.setAttribute('readonly', '');
					ta.style.cssText = 'position:fixed;opacity:0';
					document.body.append(ta);
					ta.select();
					const ok = document.execCommand('copy');
					ta.remove();
					return ok;
				}
			}

			document.addEventListener('click', async (e) => {
				const btn = (e.target as Element).closest<HTMLButtonElement>('[data-copy], .copy-btn');
				if (!btn) return;
				const text = btn.dataset.copy ?? btn.closest('.cmd')?.querySelector('code')?.textContent ?? '';
				if (!text.trim()) return;
				const ok = await copy(text);
				const what = btn.dataset.copyLabel ?? 'Comando';
				announce(ok ? `${what} copiado` : 'No se pudo copiar; selecciona el texto');
				btn.classList.add(ok ? 'is-copied' : 'is-failed');
				const label = btn.querySelector('.copy-label');
				const prev = label?.textContent;
				if (label) label.textContent = ok ? 'Copiado' : 'Error';
				setTimeout(() => {
					btn.classList.remove('is-copied', 'is-failed');
					if (label && prev) label.textContent = prev;
				}, 1600);
			});
		</script>
	</body>
</html>
