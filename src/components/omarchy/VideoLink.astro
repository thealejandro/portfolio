---
// Miniatura de un vídeo: abre el visor y lo reproduce allí. Sin JS, enlace al archivo.
import type { Video } from './media';

interface Props {
	video: Video;
	class?: string;
	imgClass?: string;
	loading?: 'eager' | 'lazy';
}
const { video, class: cls, imgClass, loading = 'lazy' } = Astro.props;
const fallback = video.sources.find((s) => s.type === 'video/mp4') ?? video.sources[0];
---

<a
	class:list={[
		'group/shot relative block cursor-pointer overflow-hidden bg-[#0b0d16] shadow-[0_0_0_1px_rgb(15_18_25/0.08)] [transform:translateZ(0)]',
		cls,
	]}
	href={fallback.src}
	data-lb
	data-video={JSON.stringify(video.sources)}
	data-poster={video.poster}
	data-alt={video.alt}
	data-label={video.label}
>
	<img
		src={video.poster}
		alt={video.alt}
		width={video.width}
		height={video.height}
		loading={loading}
		decoding="async"
		class:list={['block h-auto w-full transition-transform duration-700 ease-apple group-hover/shot:scale-[1.025]', imgClass]}
	/>
	<span class="absolute inset-0 grid place-items-center bg-black/10 transition-colors group-hover/shot:bg-black/0" aria-hidden="true">
		<span class="grid size-14 place-items-center rounded-full bg-loza/90 text-esmalte shadow-lift transition-transform duration-500 ease-spring group-hover/shot:scale-110">
			<svg viewBox="0 0 16 16" class="ml-0.5 size-5" fill="currentColor"><path d="M4.5 2.8v10.4a.6.6 0 0 0 .9.5l8.2-5.2a.6.6 0 0 0 0-1L5.4 2.3a.6.6 0 0 0-.9.5Z"></path></svg>
		</span>
	</span>
	<span class="absolute top-3 left-3 rounded-full bg-esmalte/85 px-2.5 py-0.5 text-xs font-bold text-loza" aria-hidden="true">Vídeo</span>
	<span class="sr-only">(vídeo)</span>
</a>
