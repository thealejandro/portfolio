---
interface Props {
	command: string;
	label?: string;
	class?: string;
	id?: string;
}
const { command, label = 'Comando', class: cls, id } = Astro.props;
---

<div class:list={['cmd', cls]}>
	<div class="flex min-h-11 items-center justify-between py-1.5 pr-1.5 pl-3.5">
		<span class="flex gap-1.5" aria-hidden="true">
			<i class="size-[9px] rounded-full bg-white/20"></i><i class="size-[9px] rounded-full bg-white/20"></i><i
				class="size-[9px] rounded-full bg-white/20"></i>
		</span>
		<button type="button" class="copy-btn" data-copy-label={label} aria-label={`Copiar: ${label}`} data-js-only>
			<svg viewBox="0 0 16 16" aria-hidden="true" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5"
				><rect x="5" y="5" width="9" height="9" rx="2"></rect><path
					d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"></path></svg
			>
			<span class="copy-label">Copiar</span>
		</button>
	</div>
	<pre tabindex="0" aria-label={label}><code id={id}>{command}</code></pre>
</div>
