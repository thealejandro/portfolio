---
interface Props {
	mode: 'light' | 'dark';
}
const { mode } = Astro.props;
---

<span class:list={['badge', mode === 'dark' && 'badge-dark']}>
	{
		mode === 'dark' ? (
			<svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
				<path d="M13.5 10.2A6 6 0 0 1 5.8 2.5a6 6 0 1 0 7.7 7.7Z" />
			</svg>
		) : (
			<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
				<circle cx="8" cy="8" r="2.8" />
				<path d="M8 1.5v1.3M8 13.2v1.3M1.5 8h1.3M13.2 8h1.3M3.4 3.4l.9.9M11.7 11.7l.9.9M3.4 12.6l.9-.9M11.7 4.3l.9-.9" />
			</svg>
		)
	}
	{mode === 'dark' ? 'Oscuro' : 'Claro'}
</span>
