---
import ThemeCard from './ThemeCard.astro';
import type { Theme } from './themes';

interface Props {
	themes: Theme[];
}
const { themes } = Astro.props;

const filters = [
	{ id: 'all', label: 'Todos', test: () => true },
	{ id: 'light', label: 'Claros', test: (t: Theme) => t.mode === 'light' },
	{ id: 'dark', label: 'Oscuros', test: (t: Theme) => t.mode === 'dark' },
	{ id: 'macos', label: 'macOS', test: (t: Theme) => t.family === 'macos' },
	{ id: 'windows', label: 'Windows', test: (t: Theme) => t.family === 'windows' },
	{ id: 'propio', label: 'Diseño propio', test: (t: Theme) => t.family === 'propio' },
].map((f) => ({ ...f, count: themes.filter(f.test).length }));
---

<section id="temas" class="section" aria-labelledby="temas-title" data-browser>
	<div class="wrap">
		<div class="mb-8 flex flex-wrap items-end justify-between gap-x-8 gap-y-5">
			<div data-reveal>
				<p class="eyebrow">Temas</p>
				<h2 id="temas-title" class="title">Elige tu escritorio</h2>
				<p class="lead">Abre cualquier tema para ver todas sus capturas, la paleta completa y cómo instalarlo.</p>
			</div>
			<div class="pill-row min-w-0 max-sm:w-[calc(100%+2rem)]" role="group" aria-label="Filtrar temas" data-js-only data-reveal style="--i:1">
				{
					filters.map((f, i) => (
						<button type="button" class="pill" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
							{f.label}
							<span class="n" aria-hidden="true">{f.count}</span>
						</button>
					))
				}
			</div>
		</div>
		<p class="sr-only" aria-live="polite" data-status></p>

		<ul class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,300px),1fr))] content-start gap-6" role="list">
			{
				themes.map((t, i) => (
					<li data-mode={t.mode} data-family={t.family} data-reveal style={`--i:${i % 3}`} class="[&[hidden]]:hidden">
						<ThemeCard theme={t} eager={i < 3} />
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	const root = document.querySelector<HTMLElement>('[data-browser]');
	if (root) {
		const items = [...root.querySelectorAll<HTMLLIElement>('ul > li')];
		const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
		const grid = root.querySelector<HTMLElement>('ul')!;
		const status = root.querySelector('[data-status]')!;
		const match = (li: HTMLLIElement, f: string) =>
			f === 'all' || li.dataset.mode === f || li.dataset.family === f;

		root.querySelector('[role="group"]')?.addEventListener('click', (e) => {
			const btn = (e.target as Element).closest<HTMLButtonElement>('[data-filter]');
			if (!btn || btn.getAttribute('aria-pressed') === 'true') return;
			const f = btn.dataset.filter!;
			// Reserva la altura actual para que la página no salte al filtrar.
			grid.style.minHeight = `${Math.max(grid.offsetHeight, parseFloat(grid.style.minHeight) || 0)}px`;
			for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
			let n = 0;
			for (const li of items) {
				const show = match(li, f);
				li.hidden = !show;
				if (show) n++;
			}
			status.textContent = `${n} ${n === 1 ? 'tema' : 'temas'}`;
		});
		addEventListener('resize', () => (grid.style.minHeight = ''), { passive: true });
	}
</script>
