---
import { Image } from 'astro:assets';
import ModeBadge from './ModeBadge.astro';
import type { Theme } from './themes';

interface Props {
	themes: Theme[];
	initial: string;
}
const { themes, initial } = Astro.props;
const shown = themes.filter((t) => t.cover);
const counts = {
	light: themes.filter((t) => t.mode === 'light').length,
	dark: themes.filter((t) => t.mode === 'dark').length,
};
---

<section class="pt-[clamp(2.5rem,7vw,5.5rem)]" aria-labelledby="hero-title">
	<div class="wrap flex flex-col items-center text-center">
		<p class="eyebrow" data-enter style="--i:0">Omarchy</p>
		<h1 id="hero-title" class="mb-4 text-display font-bold" data-enter style="--i:1">
			Temas para Omarchy
		</h1>
		<p class="mx-auto mb-7 max-w-184 text-lead text-muted" data-enter style="--i:2">
			Once temas minimalistas para <a href="https://omarchy.org" target="_blank" rel="noopener noreferrer"
				>Omarchy</a
			>, inspirados en macOS y Windows. Cada uno trae su paleta, iconos, fondos de pantalla y esquinas
			redondeadas; la terminal, btop, Neovim, VS Code y la barra se adaptan solos.
		</p>
		<div class="flex flex-wrap justify-center gap-3" data-enter style="--i:3">
			<a class="btn btn-primary" href="#instalar">Arma tu instalación</a>
			<a class="btn btn-ghost" href="#temas">Ver los {themes.length} temas</a>
		</div>
		<p class="mt-4 text-[0.85rem] text-muted" data-enter style="--i:4">
			{counts.light} claros · {counts.dark} oscuros · licencia MIT
		</p>
	</div>

	<div class="wrap mt-[clamp(2.5rem,6vw,4.5rem)]" data-hero data-enter style="--i:5">
		{
			shown.map((t) => (
				<figure class="m-0 motion-safe:animate-fade" data-slug={t.slug} hidden={t.slug !== initial}>
					<div class="scroll-zoom">
						<div
							class="relative aspect-video rounded-[clamp(12px,1.6vw,22px)] shadow-screen"
							style={`background:${t.palette.background}`}
						>
							<Image
								src={t.cover!.img}
								alt={t.cover!.alt}
								widths={[640, 960, 1280, 1600]}
								sizes="(max-width: 1232px) calc(100vw - 32px), 1200px"
								loading={t.slug === initial ? 'eager' : 'lazy'}
								fetchpriority={t.slug === initial ? 'high' : 'auto'}
								class="block size-full rounded-[inherit] object-cover"
							/>
						</div>
					</div>
					<figcaption class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 text-[0.95rem]">
						<span class="font-bold text-ink">{t.name}</span>
						<span class="text-muted">{t.tag}</span>
						<ModeBadge mode={t.mode} />
						<a class="inline-flex min-h-11 items-center gap-1 font-bold no-underline hover:underline" href={`/omarchy/${t.slug}`}>
							Ver detalles<span class="sr-only"> de {t.name}</span>
							<span aria-hidden="true">→</span>
						</a>
					</figcaption>
				</figure>
			))
		}

		<div
			class="pill-row mx-auto mt-3 max-w-195 sm:justify-center"
			role="group"
			aria-label="Vista previa del tema"
			data-picker
			data-js-only
		>
			{
				shown.map((t) => (
					<button type="button" class="pill" data-slug={t.slug} aria-pressed={t.slug === initial ? 'true' : 'false'}>
						<span class="pill-dot" style={`background:${t.palette.accent}`} aria-hidden="true" />
						{t.name}
					</button>
				))
			}
		</div>
	</div>
</section>

<script>
	const root = document.querySelector<HTMLElement>('[data-hero]');
	const picker = root?.querySelector<HTMLElement>('[data-picker]');
	if (root && picker) {
		const slides = [...root.querySelectorAll<HTMLElement>('figure[data-slug]')];
		const buttons = [...picker.querySelectorAll<HTMLButtonElement>('button[data-slug]')];
		const slideOf = (slug?: string) => slides.find((s) => s.dataset.slug === slug);
		// Las vistas ocultas usan loading=lazy; se piden antes de mostrarlas
		// (al pasar el puntero o enfocar el botón) para que no aparezcan vacías.
		const warm = (slug?: string) =>
			slideOf(slug)
				?.querySelectorAll('img')
				.forEach((img) => (img.loading = 'eager'));

		const center = (btn: HTMLElement) => {
			if (picker.scrollWidth <= picker.clientWidth) return;
			const left = btn.offsetLeft - picker.clientWidth / 2 + btn.offsetWidth / 2;
			const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
			picker.scrollTo({ left, behavior: smooth ? 'smooth' : 'auto' });
		};

		picker.addEventListener('pointerover', (e) => warm((e.target as Element).closest<HTMLElement>('[data-slug]')?.dataset.slug));
		picker.addEventListener('focusin', (e) => warm((e.target as HTMLElement).dataset.slug));
		picker.addEventListener('click', (e) => {
			const btn = (e.target as Element).closest<HTMLButtonElement>('button[data-slug]');
			if (!btn) return;
			const slug = btn.dataset.slug;
			for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
			for (const s of slides) s.hidden = s.dataset.slug !== slug;
			center(btn);
			// Precarga el siguiente para recorrerlos sin esperas.
			const i = buttons.indexOf(btn);
			warm(buttons[(i + 1) % buttons.length].dataset.slug);
		});
		center(buttons.find((b) => b.getAttribute('aria-pressed') === 'true') ?? buttons[0]);
	}
</script>
