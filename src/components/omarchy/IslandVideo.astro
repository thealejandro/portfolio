---
// Demo de la isla (convertida del GIF del repo a MP4/WebM: ~10× más ligera).
// Solo se reproduce mientras está en pantalla y sin prefers-reduced-motion;
// sin JS muestra los controles nativos.
interface Props {
	class?: string;
}
const { class: cls } = Astro.props;
---

<figure class:list={['m-0', cls]}>
	<div class="overflow-hidden rounded-[clamp(12px,1.8vw,20px)] bg-[#07081a] shadow-[0_0_0_1px_rgb(255_255_255/0.08),0_30px_80px_rgb(7_8_26/0.45)]">
		<video
			class="block aspect-[800/450] h-auto w-full"
			width="800"
			height="450"
			muted
			loop
			playsinline
			controls
			preload="none"
			poster="/omarchy/island-demo-v2-poster.webp"
			aria-label="Demostración de omarchy-island: la isla se asoma con la canción, se abre desde el reloj y pasa por el calendario con la agenda, Inicio, las notificaciones y los ajustes"
			data-autoplay
		>
			<source src="/omarchy/island-demo-v2.webm" type="video/webm" />
			<source src="/omarchy/island-demo-v2.mp4" type="video/mp4" />
		</video>
	</div>
	<figcaption class="mt-3 text-center text-[0.85rem] text-muted">
		La isla en 20 segundos: vistazo, calendario con agenda, inicio, notificaciones y ajustes (demo con textos en inglés).
	</figcaption>
</figure>

<script>
	const reduce = matchMedia('(prefers-reduced-motion: reduce)');
	for (const v of document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]')) {
		if (reduce.matches || !('IntersectionObserver' in window)) continue;
		v.controls = false;
		let inView = false;
		const sync = () => {
			if (inView && !document.hidden) v.play().catch(() => (v.controls = true));
			else v.pause();
		};
		new IntersectionObserver(
			([e]) => {
				inView = e.isIntersecting;
				sync();
			},
			{ threshold: 0.35 },
		).observe(v);
		document.addEventListener('visibilitychange', sync);
	}
</script>
