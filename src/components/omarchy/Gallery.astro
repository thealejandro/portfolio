---
import { getImage, Image } from 'astro:assets';
import type { Shot } from './themes';

interface Props {
	shots: Shot[];
	name: string;
}
const { shots, name } = Astro.props;

const items = await Promise.all(
	shots.map(async (s) => ({
		...s,
		full: await getImage({ src: s.img, width: Math.min(s.img.width, 1920), format: 'webp' }),
	})),
);
---

<div class="gallery" data-gallery>
	<ul class="shots" role="list">
		{
			items.map((s, i) => (
				<li class:list={[i === 0 && 'lead']}>
					<figure>
						<a
							class="shot"
							href={s.full.src}
							data-index={i}
							data-full={s.full.src}
							data-alt={s.alt}
							data-label={s.label}
						>
							<Image
								src={s.img}
								alt={s.alt}
								widths={i === 0 ? [640, 960, 1280] : [480, 800]}
								sizes={
									i === 0
										? '(max-width: 1232px) calc(100vw - 32px), 1200px'
										: '(max-width: 640px) calc(100vw - 32px), (max-width: 1000px) calc(50vw - 28px), 390px'
								}
								loading={i === 0 ? 'eager' : 'lazy'}
								fetchpriority={i === 0 ? 'high' : 'auto'}
							/>
							<span class="zoom" aria-hidden="true">
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
									<path d="M9.5 2.5h4v4M6.5 13.5h-4v-4M13.5 2.5 9 7M2.5 13.5 7 9" />
								</svg>
							</span>
						</a>
						<figcaption>{s.label}</figcaption>
					</figure>
				</li>
			))
		}
	</ul>

	<dialog class="lightbox" aria-label={`Capturas de ${name}`}>
		<div class="lb-bar">
			<p class="lb-caption"><span class="lb-label"></span> <span class="lb-count"></span></p>
			<button type="button" class="lb-btn lb-close" aria-label="Cerrar">
				<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
					><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path></svg
				>
			</button>
		</div>
		<div class="lb-stage">
			<img class="lb-img" alt="" decoding="async" />
		</div>
		{
			items.length > 1 && (
				<div class="lb-nav">
					<button type="button" class="lb-btn lb-prev" aria-label="Captura anterior">
						<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
							<path d="M10 3 5 8l5 5" />
						</svg>
					</button>
					<button type="button" class="lb-btn lb-next" aria-label="Captura siguiente">
						<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
							<path d="m6 3 5 5-5 5" />
						</svg>
					</button>
				</div>
			)
		}
	</dialog>
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
		const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
		const links = [...root.querySelectorAll<HTMLAnchorElement>('a.shot')];
		const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
		const label = dialog.querySelector('.lb-label')!;
		const count = dialog.querySelector('.lb-count')!;
		let index = 0;
		let opener: HTMLElement | null = null;

		const show = (i: number) => {
			index = (i + links.length) % links.length;
			const a = links[index];
			img.src = a.dataset.full!;
			img.alt = a.dataset.alt!;
			label.textContent = a.dataset.label!;
			count.textContent = links.length > 1 ? `${index + 1} de ${links.length}` : '';
		};

		links.forEach((a, i) =>
			a.addEventListener('click', (e) => {
				if (typeof dialog.showModal !== 'function') return;
				e.preventDefault();
				opener = a;
				show(i);
				dialog.showModal();
				dialog.querySelector<HTMLElement>('.lb-close')?.focus();
			}),
		);

		dialog.querySelector('.lb-close')?.addEventListener('click', () => dialog.close());
		dialog.querySelector('.lb-prev')?.addEventListener('click', () => show(index - 1));
		dialog.querySelector('.lb-next')?.addEventListener('click', () => show(index + 1));
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog || (e.target as Element).classList.contains('lb-stage')) dialog.close();
		});
		dialog.addEventListener('close', () => {
			opener?.focus();
			img.removeAttribute('src');
		});
		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft' && links.length > 1) {
				e.preventDefault();
				show(index - 1);
			} else if (e.key === 'ArrowRight' && links.length > 1) {
				e.preventDefault();
				show(index + 1);
			} else if (e.key === 'Tab') {
				// Mantiene el foco dentro del diálogo.
				const f = [...dialog.querySelectorAll<HTMLElement>('button')];
				const first = f[0];
				const last = f[f.length - 1];
				if (e.shiftKey && document.activeElement === first) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			}
		});
	}
</script>

<style>
	.shots {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.shots .lead {
		grid-column: 1 / -1;
	}
	figure {
		margin: 0;
	}
	.shot {
		position: relative;
		display: block;
		border-radius: 14px;
		overflow: hidden;
		background: var(--om-soft);
		box-shadow:
			0 0 0 1px rgba(15, 18, 25, 0.08),
			var(--om-shadow);
		cursor: zoom-in;
	}
	.lead .shot {
		border-radius: clamp(12px, 1.6vw, 20px);
		box-shadow:
			0 0 0 1px rgba(15, 18, 25, 0.08),
			var(--om-shadow-lg);
	}
	.shot img {
		display: block;
		width: 100%;
		height: auto;
		transition: transform 0.5s var(--om-ease);
	}
	.shot:hover img {
		transform: scale(1.01);
	}
	.shot:focus-visible {
		outline-offset: 4px;
	}
	.zoom {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: rgba(15, 18, 25, 0.75);
		color: #fff;
		opacity: 0;
		transition: opacity 0.2s;
	}
	.zoom svg {
		width: 16px;
		height: 16px;
	}
	.shot:hover .zoom,
	.shot:focus-visible .zoom {
		opacity: 1;
	}
	@media (hover: none) {
		.zoom {
			opacity: 1;
		}
	}
	figcaption {
		margin-top: 0.6rem;
		font-size: 0.9rem;
		color: var(--om-muted);
	}

	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgba(10, 12, 18, 0.97);
		color: #fff;
	}
	.lightbox[open] {
		display: grid;
		grid-template-rows: auto 1fr;
		animation: lb-in 0.2s ease-out;
	}
	.lightbox::backdrop {
		background: rgba(10, 12, 18, 0.6);
	}
	.lb-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 1rem;
	}
	.lb-caption {
		margin: 0;
		font-weight: 700;
	}
	.lb-count {
		margin-left: 0.5rem;
		font-weight: 400;
		color: #c5cbd8;
		font-variant-numeric: tabular-nums;
	}
	.lb-stage {
		display: grid;
		place-items: center;
		min-height: 0;
		padding: 0 clamp(0.75rem, 6vw, 5rem) clamp(4.5rem, 8vh, 5rem);
	}
	.lb-img {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		border-radius: 12px;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
	}
	.lb-nav {
		position: absolute;
		left: 50%;
		bottom: 1rem;
		display: flex;
		gap: 0.75rem;
		transform: translateX(-50%);
	}
	.lb-btn {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.25);
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
		cursor: pointer;
	}
	.lb-btn:hover {
		background: rgba(255, 255, 255, 0.18);
	}
	.lb-btn svg {
		width: 18px;
		height: 18px;
	}
	.lb-btn:focus-visible {
		outline: 2px solid #9db0ff;
		outline-offset: 2px;
	}
	@keyframes lb-in {
		from {
			opacity: 0;
		}
	}
</style>
